    <xpath expr="//div[hasclass('col-lg-3')]/h2" position="replace" mode="inner">
        Barcelona
    </xpath>
    <xpath expr="//div[hasclass('col-lg-3')]/p" position="replace" mode="inner">
        27th of August
    </xpath>

    <xpath expr="//div[hasclass('col-lg-3')][2]/h2" position="replace" mode="inner">
        Amsterdam
    </xpath>
    <xpath expr="//div[hasclass('col-lg-3')][2]/p" position="replace" mode="inner">
        4th of September
