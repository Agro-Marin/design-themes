        Brussels
    </xpath>
    <xpath expr="//div[hasclass('col-lg-4')]/p" position="replace" mode="inner">
        21th of August
    </xpath>

    <xpath expr="//div[hasclass('col-lg-4')][2]/h2" position="replace" mode="inner">
