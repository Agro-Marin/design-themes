<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_features" inherit_id="website.s_features">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc o_cc2" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('row')]//div//i" position="attributes">
        <attribute name="class" add="bg-o-color-4 fa-solid fa-shield" remove="bg-o-color-3 fa-regular fa-paper-plane" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('row')]//div//h3" position="replace" mode="inner">
        Secured
    </xpath>
    <xpath expr="//div[hasclass('row')]//div[2]//i" position="attributes">
        <attribute name="class" add="bg-o-color-4 fa-solid fa-laptop" remove="bg-o-color-3 fa-regular fa-credit-card" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('row')]//div[2]//h3" position="replace" mode="inner">
        All in one
    </xpath>
    <xpath expr="//div[hasclass('row')]//div[3]//i" position="attributes">
        <attribute name="class" add="bg-o-color-4 fa-solid fa-star" remove="bg-o-color-3 fa-regular fa-flag" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('row')]//div[3]//h3" position="replace" mode="inner">
        Easy to use
    </xpath>
</template>

</odoo>
